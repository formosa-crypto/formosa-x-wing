from formosa25519 require "crypto_scalarmult/curve25519/amd64/mulx/curve25519.jinc"

fn xwing_x25519_base(#spill_to_mmx reg mut ptr u8[32] qp, reg const ptr u8[32] np) -> reg ptr u8[32]
{
  reg u64[4] q n;

  n = #copy(np);
  () = #spill(qp,np);

  q = __curve25519_mulx_base(n); // q = nG

  () = #unspill(qp);
  qp = #copy(q);
  return qp;

}

fn xwing_x25519(#spill_to_mmx reg mut ptr u8[32] qp, reg const ptr u8[32] np, reg const ptr u8[32] pp) -> reg ptr u8[32]
{
  reg u64[4] q n p;

  p = #copy(pp);
  n = #copy(np);
  () = #spill(qp);
  q = __curve25519_mulx(n, p); // q = nP
  () = #unspill(qp);
  qp = #copy(q);

  return qp;
}
